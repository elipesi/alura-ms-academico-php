{
  "autoload": {
    "psr-4": {
      "Alura\\Academico\\": "src/"
    },
    "files": [
      "functions.php"
    ]
  },
  "require": {
    "php-amqplib/php-amqplib": "^3.0",
    "symfony/mailer": "^5.3",
    "symfony/google-mailer": "^5.3"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.6.0"
  },
  "scripts": {
    "phpcs": "phpcs --standard=PSR12 --colors receive.php",
    "phpcbf": "php vendor/bin/phpcbf --standard=PSR12 --colors ."
},
"config": {
    "allow-plugins": {
        "php-http/discovery": true
    },
    "policy": {
        "advisories": {
            "ignore": [
                "squizlabs/php_codesniffer"
            ]
        }
    }
}
}
